POSTGRES_USER=postgres
POSTGRES_PASSWORD=Strong!Pass910
REDIS_PASSWORD=Strong!Pass900
MYSQL_PASSWORD=Strong!Pass890

POSTGRES_HOST_CATALOG=catalog_db
POSTGRES_HOST_BASKET=basket_db
MYSQL_HOST_PROMOTION=promotion_db
REDIS_HOST_BASKET=basket_redis

POSTGRES_DB_NAME_CATALOG=catalog-db
POSTGRES_DB_NAME_BASKET=basket-db
MYSQL_DB_NAME_PROMOTION=promotion-db

POSTGRES_PORT_CATALOG=7101
POSTGRES_PORT_BASKET=7102
MYSQL_PORT_PROMOTION=7103
REDIS_PORT_BASKET=7122

PG_CONNECTION_CATALOG="Host=${POSTGRES_HOST_CATALOG};Database=${POSTGRES_DB_NAME_CATALOG};
User Id=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Include Error Detail=true;Pooling=true;Maximum Pool Size=100;Connection Lifetime=0"

PG_CONNECTION_BASKET="Host=${POSTGRES_HOST_BASKET};Database=${POSTGRES_DB_NAME_BASKET};
User Id=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Include Error Detail=true;Pooling=true;Maximum Pool Size=100;Connection Lifetime=0"

MYSQL_CONNECTION_PROMOTION="Host=${MYSQL_HOST_PROMOTION};Database=${MYSQL_DB_NAME_PROMOTION};
User=root;Password=${MYSQL_PASSWORD};Pooling=true;Maximum Pool Size=100"

REDIS_CONNECTION_BASKET="${REDIS_HOST_BASKET},password=${REDIS_PASSWORD},ssl=false,abortConnect=false"